# TinyFish API — get yours at https://agent.tinyfish.ai
TINYFISH_API_KEY="your_tinyfish_api_key_here"

# OpenRouter API (optional — set llm_provider=openrouter) — free tier at https://openrouter.ai
OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
OPENROUTER_FALLBACK_MODELS="nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,qwen/qwen3-coder:free"

# Claude via the Claude Agent SDK (default provider: llm_provider=claude_agent_sdk)
# Required for claude_agent_sdk (also used by llm_provider=anthropic).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY="your_anthropic_api_key_here"
# CLAUDE_AGENT_SDK_MODEL="claude-opus-5-5"   # default; any Claude model ID works

# Claude Code CLI (optional — no API key needed, uses local claude auth)
# Requires: Claude Code installed (https://claude.ai/code) + claude auth login
# LLM_PROVIDER="claude_cli"
# CLAUDE_CLI_MODEL=""   # empty = claude's default; or "sonnet", "opus", "haiku"

# Telegram Notification (optional — create bot via @BotFather)
TELEGRAM_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Candidate Configuration (overrides config.json)
CANDIDATE_NAME="Your Name"
RESUME_PATH="resume/YOUR_RESUME.md"
MIN_SCORE=60
TOP_N=5
